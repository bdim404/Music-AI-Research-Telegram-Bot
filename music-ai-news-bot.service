[Unit]
Description=Music AI News Bot
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/etc/Music-AI-Research-Telegram-Bot
ExecStart=/etc/Music-AI-Research-Telegram-Bot/venv/bin/python -m src.main
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
